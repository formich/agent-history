class ConversationList(OptionList):
    BINDINGS = [Binding("enter", "select", S["k_resume"])]


class RenameScreen(ModalScreen[str | None]):
    BINDINGS = [Binding("escape", "dismiss(None)", S["k_cancel"])]

    def __init__(self, current: str):
        super().__init__()
        self.current = current

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Label(S["rename_title"], id="dialog-title")
            yield Input(value=self.current, id="rename-input")
            yield Label(S["rename_hint"], id="dialog-hint")

    @on(Input.Submitted)
    def done(self, ev: Input.Submitted) -> None:
        self.dismiss(ev.value.strip() or None)


class AgentsScreen(ModalScreen[set | None]):
    """Switch agents on/off; the caller persists the result."""
    BINDINGS = [Binding("escape", "dismiss(None)", S["k_cancel"]),
                Binding("enter", "save", S["saved"], priority=True)]

    def __init__(self, enabled: set[str], counts: dict[str, int]):
        super().__init__()
        self.enabled, self.counts = enabled, counts

    def compose(self) -> ComposeResult:
        items = []
        for a, meta in AGENTS.items():
            n = self.counts.get(a)
            note = S["not_found"] if n is None else S["sessions_n"].format(n=n)
            prompt = Text.assemble((meta["glyph"] + " ", f"bold {meta['color']}"),
                                   (f"{meta['name']:<14}", INK), (note, MUTED))
            items.append(Selection(prompt, a, a in self.enabled))
        with Vertical(id="dialog"):
            yield Label(S["settings_title"], id="dialog-title")
            yield SelectionList[str](*items, id="agent-toggles")
            yield Label(S["settings_hint"], id="dialog-hint")

    def action_save(self) -> None:
        chosen = set(self.query_one("#agent-toggles", SelectionList).selected)
        if not chosen:
            self.notify(S["settings_need_one"], severity="warning")
            return
        self.dismiss(chosen)


def make_theme():
    base = BUILTIN_THEMES["tokyo-night"]
    return dataclasses.replace(base, name="agent-history", primary=BLUE,
                               secondary="#7dcfff", accent="#ff9e64")


