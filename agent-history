TEXT_TYPES = {"text", "input_text", "output_text"}
NOISE_PREFIXES = ("<", "# AGENTS.md instructions", "# Context from my IDE setup")


def text_of(content) -> str:
    """Human-written text of a message (skips tool calls/results and injected context)."""
    if isinstance(content, str):
        parts = [content]
    elif isinstance(content, list):
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") in TEXT_TYPES]
    else:
        return ""
    return "\n".join(p.strip() for p in parts
                     if p and not p.lstrip().startswith(NOISE_PREFIXES)).strip()


def iter_records(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def read_records(path: str, start: int = 0) -> tuple[list[dict], int]:
    """Parse the complete JSON lines from byte `start`; return them and the new offset.

    A line still being written (no trailing newline) is left for the next read, so
    sessions that are open in an agent can be read incrementally and safely.
    """
    with open(path, "rb") as fh:
        fh.seek(start)
        data = fh.read()
    end = data.rfind(b"\n") + 1
    out = []
    for line in data[:end].splitlines():
        if line.strip():
            try:
                out.append(json.loads(line.decode("utf-8", "replace")))
            except ValueError:
                continue
    return out, start + end


def file_head(path: str) -> str:
    """Fingerprint of a file's start, to notice a session file that was rewritten."""
    with open(path, "rb") as fh:
        return fh.read(160).decode("latin-1")


def new_info(path: str, agent: str, sid: str) -> dict:
    return {"path": path, "agent": agent, "id": sid, "cwd": None, "branch": None,
            "ai_title": None, "custom_title": None, "prompts": [], "first": None,
            "last": None, "n_user": 0, "n_asst": 0, "hidden": False}


def touch(info: dict, ts) -> None:
    if ts:
        info["first"] = info["first"] or ts
        info["last"] = ts


def add_message(info: dict, role: str, txt: str) -> None:
    if not txt:
        return
    if role == "user":
        info["n_user"] += 1
        info["prompts"].append(txt[:600])
    else:
        info["n_asst"] += 1


# Claude Code: ~/.claude/projects/<folder>/<session-id>.jsonl
def scan_claude(path: str, info: dict | None = None, start: int = 0) -> dict:
    info = info or new_info(path, "claude", os.path.basename(path)[:-6])
    records, info["offset"] = read_records(path, start)
    for d in records:
        t = d.get("type")
        if t == "ai-title" and d.get("aiTitle"):
            info["ai_title"] = d["aiTitle"]
        elif t == "custom-title" and d.get("customTitle"):
            info["custom_title"] = d["customTitle"]
        elif t == "summary" and d.get("summary") and not info["ai_title"]:
            info["ai_title"] = d["summary"]
        elif t in ("user", "assistant") and not d.get("isSidechain") and not d.get("isMeta"):
            touch(info, d.get("timestamp"))
            if t == "user":
                info["cwd"] = info["cwd"] or d.get("cwd")
                info["branch"] = d.get("gitBranch") or info["branch"]
            add_message(info, t, text_of((d.get("message") or {}).get("content")))
    return info


def claude_messages(path: str):
    for d in iter_records(path):
        t = d.get("type")
        if t in ("user", "assistant") and not d.get("isSidechain") and not d.get("isMeta"):
            yield t, d.get("timestamp"), text_of((d.get("message") or {}).get("content"))


# Codex: ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl, titles in session_index.jsonl
def scan_codex(path: str, info: dict | None = None, start: int = 0) -> dict:
    info = info or new_info(path, "codex", "")
    records, info["offset"] = read_records(path, start)
    for d in records:
        t, p = d.get("type"), d.get("payload") or {}
        if t == "session_meta":
            info["id"] = p.get("id") or p.get("session_id") or ""
            info["cwd"] = p.get("cwd")
            git = p.get("git") or {}
            info["branch"] = git.get("branch") if isinstance(git, dict) else None
            src = p.get("source")
            # sub-agents (e.g. the approval "guardian") aren't conversations you had
            info["hidden"] = isinstance(src, dict) and "subagent" in src
        elif t == "turn_context" and p.get("cwd"):
            info["cwd"] = info["cwd"] or p["cwd"]
        elif t == "response_item" and p.get("type") == "message" and p.get("role") in ("user", "assistant"):
            touch(info, d.get("timestamp"))
            add_message(info, p["role"], text_of(p.get("content")))
    return info


def codex_messages(path: str):
    for d in iter_records(path):
        p = d.get("payload") or {}
        if d.get("type") == "response_item" and p.get("type") == "message" \
                and p.get("role") in ("user", "assistant"):
            yield p["role"], d.get("timestamp"), text_of(p.get("content"))


def codex_titles() -> dict[str, str]:
    titles: dict[str, str] = {}
    path = os.path.join(CODEX_DIR, "session_index.jsonl")
    if os.path.exists(path):
        for d in iter_records(path):  # append-only: the last name wins
            if d.get("id") and d.get("thread_name"):
                titles[d["id"]] = d["thread_name"]
    return titles


# pi: <sessions>/--<cwd>--/<timestamp>_<id>.jsonl, a tree of entries (id/parentId);
# the conversation you see is the path from the last entry back to the root.
def pi_sessions_dir() -> str:
    d = os.environ.get("PI_CODING_AGENT_SESSION_DIR")
    if not d:
        try:
            with open(os.path.join(PI_DIR, "settings.json")) as fh:
                d = json.load(fh).get("sessionDir")
        except (OSError, ValueError, AttributeError):
            d = None
    return os.path.expanduser(d) if d else os.path.join(PI_DIR, "sessions")


def pi_active_path(path: str) -> tuple[dict | None, list[dict]]:
    header, entries = None, {}
    leaf = None
    for d in iter_records(path):
        if d.get("type") == "session" and header is None:
            header = d
        elif d.get("id"):
            entries[d["id"]] = d
            leaf = d["id"]
    chain, seen = [], set()
    while leaf and leaf in entries and leaf not in seen:  # guard against cycles
        seen.add(leaf)
        chain.append(entries[leaf])
        leaf = entries[leaf].get("parentId")
    return header, chain[::-1]


def scan_pi(path: str, info: dict | None = None, start: int = 0) -> dict:
    # a session is a tree, and the active branch can move anywhere: always read it whole
    header, chain = pi_active_path(path)
    info = new_info(path, "pi", (header or {}).get("id") or os.path.basename(path)[:-6].split("_")[-1])
    info["cwd"] = (header or {}).get("cwd")
    for d in chain:
        if d.get("type") == "session_info" and d.get("name"):
            info["custom_title"] = d["name"]
        elif d.get("type") == "message":
            m = d.get("message") or {}
            if m.get("role") in ("user", "assistant"):
                touch(info, d.get("timestamp"))
                add_message(info, m["role"], text_of(m.get("content")))
    info["offset"] = None
    return info


def pi_messages(path: str):
    for d in pi_active_path(path)[1]:
        m = d.get("message") or {}
        if d.get("type") == "message" and m.get("role") in ("user", "assistant"):
            yield m["role"], d.get("timestamp"), text_of(m.get("content"))


SOURCES = {
    "claude": (lambda: glob.glob(os.path.join(CLAUDE_DIR, "projects", "*", "*.jsonl")), scan_claude),
    "codex": (lambda: glob.glob(os.path.join(CODEX_DIR, "sessions", "**", "rollout-*.jsonl"), recursive=True)
              + glob.glob(os.path.join(CODEX_DIR, "archived_sessions", "**", "rollout-*.jsonl"), recursive=True),
              scan_codex),
    "pi": (lambda: glob.glob(os.path.join(pi_sessions_dir(), "*", "*.jsonl")), scan_pi),
}


def messages_of(i: dict):
    return {"claude": claude_messages, "codex": codex_messages, "pi": pi_messages}[i["agent"]](i["path"])


