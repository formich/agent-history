    #dialog-title { text-style: bold; padding-bottom: 1; }
    #dialog-hint { color: $text-muted; padding-top: 1; }
    """
    BINDINGS = [
        Binding("slash", "focus_search", S["k_search"]),
        Binding("a", "cycle_agent", S["k_agent"]),
        Binding("v", "toggle_full", S["k_full"]),
        Binding("r", "rename", S["k_rename"]),
        Binding("c", "copy", S["k_copy"]),
        Binding("o", "open_folder", S["k_open"]),
        Binding("s", "agents_settings", S["k_settings"]),
        Binding("p", "focus_projects", S["k_projects"], show=False),
        Binding("escape", "back", S["k_back"], show=False),
        Binding("q", "quit", S["k_quit"]),
    ]

    def __init__(self, query: str = "", agent: str | None = None):
        super().__init__()
        self.initial_query = query
        self.initial_agent = agent
        self.config, self.config_error = load_config()
        self.enabled = {a for a, on in self.config["agents"].items() if on}
        if agent:
            self.enabled.add(agent)  # --agent X wins over the config for this run
        self.index: list[dict] = []
        self.rows: list[dict] = []
        self.agent_filter: str | None = None
        self.project_filter: str | None = None
        self.current: dict | None = None
        self.full = False
        self.resume_target: dict | None = None
        self._preview_timer = None
        self._previewed = False

    # ---- layout
    def compose(self) -> ComposeResult:
        with Horizontal(id="top"):
            yield Static(Text.assemble(("◆ ", f"bold {BLUE}"), ("Agent History", f"bold {INK}")),
                         id="brand")
            yield Input(placeholder=S["search"], id="search")
            yield Static(id="count")
        with Horizontal(id="body"):
            with Vertical(id="sidebar"):
                yield OptionList(id="agents")
                yield OptionList(id="projects")
                with Vertical(id="activity"):
                    yield Label(S["activity"], id="activity-label")
                    yield Sparkline([0], id="spark")
                    yield Static(id="activity-caption")
            yield ConversationList(id="list")
            with VerticalScroll(id="preview"):
                yield Static(id="preview-body")
        yield Footer()

    def on_mount(self) -> None:
        self.register_theme(make_theme())
        self.theme = "agent-history"
        self.query_one("#agents").border_title = S["agents"]
        self.query_one("#projects").border_title = S["projects"]
        self.query_one("#list").border_title = S["conversations"]
        self.query_one("#preview").border_title = S["preview"]
        self.index = load_index(self.enabled)
        self.build_activity()
        self.build_agents(self.initial_agent)
        self.build_projects()
        self.query_one("#search", Input).value = self.initial_query
        self.query_one("#list").focus()
        # build the rows once the list has its real width, so they're drawn only once
        self.call_after_refresh(self.refresh_list)
        if self.config_error:
            self.notify(self.config_error, severity="warning", timeout=8)

    @on(events.Resize)
    def relayout_rows(self) -> None:
        # rows are truncated to the list's width, which is only known after layout
        self.call_after_refresh(self._fit_rows)

    def _fit_rows(self) -> None:
        built = getattr(self, "_rows_width", None)  # None: the first build hasn't happened yet
        if self.index and built is not None and self.query_one("#list").content_size.width != built:
            self.refresh_list(keep=True)

    def build_activity(self) -> None:
        today = datetime.now().astimezone().date()
        per_day = Counter(i["dt"].date() for i in self.index if i["dt"])
        data = [per_day.get(today - timedelta(days=d), 0) for d in range(29, -1, -1)]
        self.query_one("#spark", Sparkline).data = data
        self.query_one("#activity-caption", Static).update(Text.assemble(
            (S["today_lc"], MUTED), (str(data[-1]), f"bold {INK}"),
            (S["peak"], MUTED), (str(max(data)), f"bold {INK}")))

    def build_agents(self, select: str | None = None) -> None:
        ol = self.query_one("#agents", OptionList)
        ol.clear_options()
        counts = Counter(i["agent"] for i in self.index)
        ol.add_option(Option(side_row(Text("● ", style=INK_2), S["all"], len(self.index), bold=True),
                             id="__all__"))
        for agent, meta in AGENTS.items():
            if counts.get(agent):
                dot = Text(meta["glyph"] + " ", style=f"bold {meta['color']}")
                ol.add_option(Option(side_row(dot, meta["name"], counts[agent]), id=f"a:{agent}"))
        ids = [o.id for o in ol.options]
        ol.highlighted = ids.index(f"a:{select}") if f"a:{select}" in ids else 0
        self.agent_filter = ol.get_option_at_index(ol.highlighted).id[2:] if ol.highlighted else None
        ol.display = len(counts) > 1  # only useful when more than one agent has sessions

    def build_projects(self) -> None:
        ol = self.query_one("#projects", OptionList)
        ol.clear_options()
        counts = Counter(i["project"] for i in self.index)
        self.project_names = sorted(counts, key=lambda p: (-counts[p], p))
        if self.project_filter not in counts:
            self.project_filter = None
        ol.add_option(Option(side_row(Text("● ", style=INK_2), S["all"], len(self.index), bold=True),
                             id="__all__"))
        for name in self.project_names:
            ol.add_option(Option(side_row(Text("● ", style=color_for(name)), name, counts[name]),
                                 id=f"p:{name}"))
        ids = [o.id for o in ol.options]
        ol.highlighted = ids.index(f"p:{self.project_filter}") if self.project_filter else 0

    def update_counts(self, terms: list[str]) -> None:
        """Facet counts: each side list counts matches under the *other* filters."""
        hits = [i for i in self.index if all(t in i["haystack"] for t in terms)]
        by_agent = Counter(i["agent"] for i in hits
                           if self.project_filter is None or i["project"] == self.project_filter)
        by_project = Counter(i["project"] for i in hits
                             if self.agent_filter is None or i["agent"] == self.agent_filter)
        agents = self.query_one("#agents", OptionList)
        all_dot = Text("● ", style=INK_2)
        agents.replace_option_prompt("__all__", side_row(all_dot, S["all"], sum(by_agent.values()), bold=True))
        for o in list(agents.options):
            if o.id and o.id.startswith("a:"):
                a = AGENTS[o.id[2:]]
                agents.replace_option_prompt(o.id, side_row(
                    Text(a["glyph"] + " ", style=f"bold {a['color']}"), a["name"], by_agent[o.id[2:]]))
        projects = self.query_one("#projects", OptionList)
        projects.replace_option_prompt("__all__", side_row(all_dot, S["all"], sum(by_project.values()), bold=True))
        for name in self.project_names:
            projects.replace_option_prompt(f"p:{name}", side_row(
                Text("● ", style=color_for(name)), name, by_project[name]))

    # ---- filtering
    def terms(self) -> list[str]:
        return [t for t in self.query_one("#search", Input).value.lower().split() if t]

    def refresh_list(self, keep: bool = False) -> None:
        keep_path = self.current["path"] if keep and self.current else None
        terms = self.terms()
        self.rows = [i for i in self.index
                     if (self.agent_filter is None or i["agent"] == self.agent_filter)
                     and (self.project_filter is None or i["project"] == self.project_filter)
                     and all(t in i["haystack"] for t in terms)]
        ol = self.query_one("#list", OptionList)
        ol.clear_options()
        last_bucket, first_idx, opts = None, None, []
        width = max(30, (ol.content_size.width or 60) - 2)
        self._rows_width = ol.content_size.width
        keep_idx = None
        for n, i in enumerate(self.rows):
            b = bucket(i["dt"])
            if b != last_bucket:
                opts.append(Option(Text(b.upper(), style=f"bold {MUTED}"), disabled=True))
                last_bucket = b
            if first_idx is None:
                first_idx = len(opts)
            if keep_path and i["path"] == keep_path:
                keep_idx = len(opts)
            opts.append(Option(row_prompt(i, terms, width), id=str(n)))
        ol.add_options(opts)
        self.query_one("#count", Static).update(Text.assemble(
            (str(len(self.rows)), f"bold {INK}"), (S["of"].format(n=len(self.index)), MUTED)))
        self.update_counts(terms)
        if first_idx is not None:
            ol.highlighted = keep_idx if keep_idx is not None else first_idx
        else:
            self.current = None
            self.query_one("#preview-body", Static).update(Text.assemble(
                (f"\n{S['empty_title']}\n\n", f"bold {INK}"), (S["empty_hint"], MUTED)))

    @on(Input.Changed, "#search")
    def search_changed(self) -> None:
        self.refresh_list()

    @on(Input.Submitted, "#search")
    def search_submitted(self) -> None:
        self.query_one("#list").focus()

    @on(OptionList.OptionHighlighted, "#agents")
    def agent_changed(self, ev: OptionList.OptionHighlighted) -> None:
        oid = ev.option.id or "__all__"
        new = None if oid == "__all__" else oid[2:]
        if new != self.agent_filter:
            self.agent_filter = new
            self.refresh_list()

    @on(OptionList.OptionHighlighted, "#projects")
    def project_changed(self, ev: OptionList.OptionHighlighted) -> None:
        oid = ev.option.id or "__all__"
        new = None if oid == "__all__" else oid[2:]
        if new != self.project_filter:
            self.project_filter = new
            self.refresh_list()

    @on(OptionList.OptionSelected, "#agents")
    @on(OptionList.OptionSelected, "#projects")
    def side_selected(self) -> None:
        self.query_one("#list").focus()

    @on(OptionList.OptionHighlighted, "#list")
    def list_changed(self, ev: OptionList.OptionHighlighted) -> None:
        if ev.option.id is None:
            return
        self.current = self.rows[int(ev.option.id)]
        self.full = False
        if self._preview_timer:
            self._preview_timer.stop()
        if self._previewed:  # debounce while scrolling, but show the first one at once
            self._preview_timer = self.set_timer(0.08, self.load_preview)
        else:
            self._previewed = True
            self.load_preview()

    @on(OptionList.OptionSelected, "#list")
    def list_selected(self) -> None:
        self.action_resume()

    # ---- preview
    def load_preview(self) -> None:
        if self.current:
            self.render_preview(self.current, self.full)

    @work(thread=True, exclusive=True)
    def render_preview(self, i: dict, full: bool) -> None:
        msgs = []
        for role, ts, txt in messages_of(i):
            if txt:
                msgs.append((role, parse_ts(ts), txt))
                if not full and len(msgs) > PREVIEW_MESSAGES:
                    break  # the short view shows the first ones: no need to read the rest
        renderable = self.build_preview(i, msgs, full)
        self.call_from_thread(self.show_preview, i, renderable)

    def show_preview(self, i: dict, renderable) -> None:
        if i is not self.current:
            return
        self.query_one("#preview-body", Static).update(renderable)
        self.query_one("#preview").scroll_home(animate=False)

    def build_preview(self, i: dict, msgs, full: bool):
        from rich.markdown import Markdown  # imported on first preview: saves start-up time
        agent = AGENTS[i["agent"]]
        title = Text()
        if i["starred"]:
            title.append("★ ", style=f"bold {HILITE}")
        title.append(i["title"], style=f"bold {INK}")

        meta = Table.grid(padding=(0, 2))
        meta.add_column(style=MUTED, no_wrap=True)
        meta.add_column(style=INK_2)
        meta.add_row(S["agent"], Text.assemble((agent["glyph"] + " ", f"bold {agent['color']}"),
                                               (agent["name"], INK_2)))
        proj = Text.assemble(("● ", color_for(i["project"])), (i["project"], INK_2))
        if i["place"]:
            proj.append(f"  {i['place']}", style=MUTED)
        meta.add_row(S["project"], proj)
        folder = Text(i["cwd"] or "?", style=INK_2)
        if not i["exists"]:
            folder.append(S["folder_missing"], style=CRITICAL)
        meta.add_row(S["folder"], folder)
        if i["branch"] and i["branch"] != "HEAD":
            meta.add_row(S["branch"], Text(f"⎇ {i['branch']}", style=INK_2))
        if i["dt_first"]:
            meta.add_row(S["when"], Text.assemble(
                f"{i['dt_first']:%d/%m/%Y %H:%M} → {i['dt']:%d/%m %H:%M}",
                (f"   {human_duration(i['dt_first'], i['dt'])}", MUTED)))
        meta.add_row(S["msgs"], S["msgs_detail"].format(u=i["n_user"], a=i["n_asst"],
                                                        agent=agent["short"]))

        parts = [Padding(title, (1, 0, 1, 0)), meta, Padding(Rule(style=RULE), (1, 0, 0, 0))]
        terms = self.terms()
        limit_u, limit_a = (None, None) if full else (900, 500)
        shown = msgs if full else msgs[:PREVIEW_MESSAGES]
        for kind, ts, txt in shown:
            stamp = f"{ts:%H:%M}" if ts else ""
            if kind == "user":
                body = txt if limit_u is None or len(txt) <= limit_u else txt[:limit_u] + " …"
                bt = Text(body, style=INK)
                bt.highlight_words(terms, style=f"reverse {HILITE}", case_sensitive=False)
                parts.append(Padding(Panel(
                    bt, title=Text(f"› {S['you']}", style=f"bold {BLUE}"),
                    subtitle=Text(stamp, style=MUTED), title_align="left", subtitle_align="right",
                    border_style=BLUE, padding=(0, 1)), (1, 0, 0, 0)))
            else:
                body = txt if limit_a is None or len(txt) <= limit_a else txt[:limit_a] + " …"
                parts.append(Padding(Group(
                    Text.assemble((agent["glyph"] + " ", f"bold {agent['color']}"),
                                  (agent["short"], f"bold {INK}"), (f"  {stamp}", MUTED)),
                    Padding(Markdown(body, code_theme="monokai"), (0, 0, 0, 2)),
                ), (1, 0, 0, 1)))
        if not full and (len(msgs) > len(shown) or any(len(m[2]) > 500 for m in msgs)):
            parts.append(Padding(Rule(Text(S["read_all"], style=MUTED), style=RULE), (1, 0)))
        return Group(*parts)

    # ---- actions
    def action_resume(self) -> None:
        if self.current:
            self.resume_target = self.current
            self.exit()

    def action_cycle_agent(self) -> None:
        ol = self.query_one("#agents", OptionList)
        if ol.display and ol.option_count > 1:
            ol.highlighted = ((ol.highlighted or 0) + 1) % ol.option_count
            opt = ol.get_option_at_index(ol.highlighted)
            label = S["all"] if opt.id == "__all__" else AGENTS[opt.id[2:]]["name"]
            self.notify(label, title=S["agents"], timeout=1.2)

    def action_agents_settings(self) -> None:
        counts = {}
        for a in AGENTS:
            if a in self.enabled:
                counts[a] = sum(1 for i in self.index if i["agent"] == a)
            else:  # not loaded: count its session files instead
                n = session_files(a)
                counts[a] = n if n else None
        on_now = {a for a, on in self.config["agents"].items() if on}

        def apply(chosen: set | None) -> None:
            if chosen is None:
                return
            self.config["agents"] = {a: a in chosen for a in AGENTS}
            try:
                save_config(self.config)
                self.notify(S["settings_saved"].format(path=CONFIG.replace(HOME, "~")), title=S["saved"])
            except OSError as e:
                self.notify(str(e), severity="error")
            if chosen != self.enabled:
                self.enabled = set(chosen)
                self.reload()

        self.push_screen(AgentsScreen(on_now, counts), apply)

    def reload(self) -> None:
        self.index = load_index(self.enabled)
        if self.agent_filter not in self.enabled:
            self.agent_filter = None
        self.build_activity()
        self.build_agents(self.agent_filter)
        self.build_projects()
        self.refresh_list(keep=True)

    def action_focus_search(self) -> None:
        self.query_one("#search").focus()

    def action_focus_projects(self) -> None:
        self.query_one("#projects").focus()

    def action_back(self) -> None:
        s = self.query_one("#search", Input)
        if self.focused is s and s.value:
            s.value = ""
        else:
            self.query_one("#list").focus()

    def action_toggle_full(self) -> None:
        if self.current:
            self.full = not self.full
            self.render_preview(self.current, self.full)
            self.notify(S["full"] if self.full else S["short"], timeout=1.5)

    def action_copy(self) -> None:
        if not self.current:
            return
        cmd = resume_command(self.current)
        self.copy_to_clipboard(cmd)  # OSC 52, works over SSH in most terminals
        for tool in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
            try:
                subprocess.run(tool, input=cmd, text=True, check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break
            except (OSError, subprocess.CalledProcessError):
                continue
        self.notify(S["copied"], title=S["copied_t"])

    def action_open_folder(self) -> None:
        if not self.current:
            return
        if not self.current["exists"]:
            self.notify(S["no_folder"], severity="warning")
            return
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        try:
            subprocess.Popen([opener, self.current["cwd"]],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self.notify(self.current["cwd"])

    def action_rename(self) -> None:
        if not self.current:
            return
        i = self.current
        if i["agent"] != "claude":
            self.notify(S["no_rename"].format(agent=AGENTS[i["agent"]]["name"]), severity="warning")
            return

        def save(name: str | None) -> None:
            if not name or name == i["title"]:
                return
            # same record Claude Code's own /rename appends
            rec = {"type": "custom-title", "customTitle": name, "sessionId": i["id"]}
            with open(i["path"], "a", encoding="utf-8") as fh:
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
            i["custom_title"] = name
            enrich(i)
            self.refresh_list()
            self.notify(S["renamed"].format(name=name), title=S["saved"])

        self.push_screen(RenameScreen(i["title"]), save)


def main() -> None:
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip()
              .replace("@AGENTS@", ", ".join(a["name"] for a in AGENTS.values()))
              .replace("@NAMES@", ", ".join(AGENTS))
              .replace("@EXAMPLE@", "\n  ".join(f"{a} = true" for a in AGENTS)))
        return
    if args[:1] in (["-V"], ["--version"]):
        print(f"agent-history {__version__}")
        return
    if args[:1] == ["--list"]:
        cfg, err = load_config()
        if err:
            print(err, file=sys.stderr)
        for i in load_index({a for a, on in cfg["agents"].items() if on}):
            print(f"{i['dt']:%Y-%m-%d %H:%M}\t{AGENTS[i['agent']]['short']}\t{i['project']}\t{i['title']}")
        return
    dirs = [os.path.join(CLAUDE_DIR, "projects"), os.path.join(CODEX_DIR, "sessions"), pi_sessions_dir()]
    if not any(os.path.isdir(d) for d in dirs):
        sys.exit(S["none_found"].format(agents=", ".join(a["name"] for a in AGENTS.values()),
                                        dirs=", ".join(dirs)))
    agent, rest = None, []
    it = iter(args)
    for a in it:  # --agent X / --agent=X, anywhere on the command line
        if a == "--agent" or a.startswith("--agent="):
            agent = (a.split("=", 1)[1] if "=" in a else next(it, "")).lower()
            if agent not in AGENTS:
                sys.exit(f"--agent: choose one of {', '.join(AGENTS)}")
        else:
            rest.append(a)
    args = rest
    app = AgentHistory(" ".join(args), agent)
    app.run()
    i = app.resume_target
    if not i:
        return
    cwd, argv = i["cwd"] or HOME, resume_argv(i)
    executable = shutil.which(argv[0])
    if not executable:
        sys.exit(S["no_cli"].format(cli=argv[0], cmd=resume_command(i)))
    if not os.path.isdir(cwd):
        # both CLIs look sessions up from the folder they ran in, so it must exist
        os.makedirs(cwd, exist_ok=True)
        print(S["recreated"].format(cwd=cwd), file=sys.stderr)
    if os.name == "nt":
        # Keep the launcher alive until the agent exits so the shell waits too.
        sys.exit(subprocess.run([os.path.abspath(executable), *argv[1:]], cwd=cwd).returncode)
    os.chdir(cwd)
    os.execvp(argv[0], argv)


if __name__ == "__main__":
    main()
