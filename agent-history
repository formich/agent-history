def load_config() -> tuple[dict, str | None]:
    """Return ({"agents": {name: bool}}, error message or None)."""
    cfg = {"agents": {a: True for a in AGENTS}}
    try:
        with open(CONFIG, "rb") as fh:
            data = tomllib.load(fh)
    except FileNotFoundError:
        return cfg, None
    except (OSError, tomllib.TOMLDecodeError) as e:
        return cfg, S["config_error"].format(path=CONFIG, err=e)
    agents = data.get("agents") if isinstance(data.get("agents"), dict) else {}
    for a in AGENTS:
        if isinstance(agents.get(a), bool):
            cfg["agents"][a] = agents[a]
    if not any(cfg["agents"].values()):
        cfg["agents"] = {a: True for a in AGENTS}
    return cfg, None


def save_config(cfg: dict) -> None:
    lines = ["# agent-history settings. Also editable from the app (key: s);",
             "# saving from the app rewrites this file.", "", "[agents]"]
    lines += [f"{a} = {'true' if cfg['agents'].get(a, True) else 'false'}" for a in AGENTS]
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG + ".tmp", "w") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(CONFIG + ".tmp", CONFIG)


def session_files(agent: str) -> int:
    return len(SOURCES[agent][0]())


def load_index(agents: set[str] | None = None) -> list[dict]:
    agents = set(AGENTS) if agents is None else agents
    try:
        with open(CACHE) as fh:
            if os.name == "posix":
                os.fchmod(fh.fileno(), 0o600)
            cache = json.load(fh)
    except (OSError, ValueError):
        cache = {}
    seen, out, changed = set(), [], False
    for agent, (find, scan) in SOURCES.items():
        if agent not in agents:
            continue  # switched off: not even read
        for f in find():
            seen.add(f)
            try:
                st = os.stat(f)
            except OSError:
                continue
            hit = cache.get(f)
            if not hit or hit.get("mtime") != st.st_mtime:
                try:
                    head = file_head(f)
                    if (hit and hit.get("offset") is not None and hit.get("head") == head
                            and st.st_size >= hit["offset"]):
                        hit = scan(f, hit, hit["offset"])  # appended to: read only the new lines
                    else:
                        hit = scan(f)
                except OSError:
                    continue
                hit["mtime"], hit["head"] = st.st_mtime, head
                cache[f] = hit
                changed = True
            if hit["prompts"] and not hit["hidden"]:
                out.append(hit)
    # forget deleted sessions, but keep the cache of agents that are switched off
    for f in [f for f, hit in cache.items() if f not in seen and hit.get("agent") in agents]:
        del cache[f]
        changed = True
    if changed:
        cache_dir = os.path.dirname(CACHE)
        temporary_path = None
        try:
            os.makedirs(cache_dir, mode=0o700, exist_ok=True)
            with tempfile.NamedTemporaryFile(mode="w", dir=cache_dir, delete=False) as fh:
                temporary_path = fh.name
                json.dump(cache, fh)
            os.replace(temporary_path, CACHE)
        except OSError:
            # Browsing still works when the cache directory is unwritable.
            pass
        finally:
            if temporary_path is not None and os.path.exists(temporary_path):
                try:
                    os.unlink(temporary_path)
                except OSError:
                    pass
    titles = codex_titles()
    for i in out:
        if i["agent"] == "codex":
            i["ai_title"] = titles.get(i["id"]) or i["ai_title"]
        enrich(i)
    # colour follows the entity: assign by first appearance, never by rank
    firsts: dict[str, str] = {}
    for i in out:
        p, f = i["project"], i["first"] or "9"
        firsts[p] = min(firsts.get(p, f), f)
    for n, p in enumerate(sorted(firsts, key=firsts.get)):
        PROJECT_COLOR[p] = PALETTE[n] if n < len(PALETTE) else OTHER
    out.sort(key=lambda i: i["last"] or "", reverse=True)
    return out


def enrich(i: dict) -> None:
    ct = i["custom_title"]
    if ct and ct.lstrip().startswith("<"):
        ct = None
    i["starred"] = bool(ct)
    i["title"] = " ".join((ct or i["ai_title"] or i["prompts"][0].splitlines()[0]).split())
    i["project"], i["place"] = project_of(i["cwd"])
    i["dt"] = parse_ts(i["last"])
    i["dt_first"] = parse_ts(i["first"])
    i["haystack"] = " ".join([i["title"], i["cwd"] or "", i["branch"] or "",
                              AGENTS[i["agent"]]["name"], *i["prompts"]]).lower()
    i["exists"] = bool(i["cwd"]) and os.path.isdir(i["cwd"])


def project_of(cwd: str | None) -> tuple[str, str]:
    """Group a working directory into (project, place-inside-project).

    Handles git worktrees kept in a ``worktrees/<repo>/<name>`` folder, Claude
    Code's ``<repo>/.claude/worktrees/<name>`` and the Codex app's
    ``~/Documents/Codex/<date>/<task>`` scratch folders.
    """
    if not cwd:
        return "?", ""
    rel = os.path.relpath(cwd, HOME) if cwd.startswith(HOME) else cwd.strip(os.sep)
    parts = [] if rel == "." else rel.split(os.sep)
    if not parts:
        return "home", ""
    if parts[:2] == ["Documents", "Codex"]:
        return "Codex", "/".join(parts[3:] or parts[2:])
    for n, p in enumerate(parts[:-1]):
        if p == ".claude" and parts[n + 1] == "worktrees" and n > 0:
            return parts[n - 1], "/".join(parts[n + 2:])
        if p == "worktrees" and n + 1 < len(parts):
            return parts[n + 1], "/".join(parts[n + 2:])
    if parts[0] in ROOTS and len(parts) >= 2:
        return parts[1], "/".join(parts[2:])
    return parts[0], "/".join(parts[1:])


def parse_ts(ts):
    if not ts:
        return None
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()


def color_for(project: str) -> str:
    return PROJECT_COLOR.get(project, OTHER)


def resume_argv(i: dict) -> list[str]:
    if i["agent"] == "codex":
        return ["codex", "resume", i["id"]]
    if i["agent"] == "pi":
        return ["pi", "--session", i["path"]]  # by path: an id from another folder would fork
    return ["claude", "--resume", i["id"]]


def resume_command(i: dict) -> str:
    return f"cd {shlex.quote(i['cwd'] or HOME)} && {shlex.join(resume_argv(i))}"


def bucket(dt: datetime | None) -> str:
    if not dt:
        return S["no_date"]
    today = datetime.now().astimezone().date()
    d = dt.date()
    delta = (today - d).days
    if delta == 0:
        return S["today"]
    if delta == 1:
        return S["yesterday"]
    if delta < 7:
        return f"{S['days'][d.weekday()].capitalize()} {d.day} {S['months'][d.month - 1][:3]}"
    if delta < 14:
        return S["last_week"]
    return f"{S['months'][d.month - 1].capitalize()} {d.year}"


def human_duration(a, b) -> str:
    if not a or not b:
        return ""
    s = int((b - a).total_seconds())
    if s < 60:
        return S["lt_minute"]
    if s < 3600:
        return f"{s // 60} min"
    if s < 86400:
        return f"{s // 3600} h {s % 3600 // 60:02d} min"
    g = s // 86400
    return S["day"] if g == 1 else S["days_n"].format(n=g)


