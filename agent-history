def _detect_lang() -> str:
    forced = (os.environ.get("AGENT_HISTORY_LANG") or os.environ.get("CLAUDE_HISTORY_LANG") or "")
    if forced.lower()[:2] in STRINGS:
        return forced.lower()[:2]
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var, "").lower().startswith("it"):
            return "it"
    return "en"


