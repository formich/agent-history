def fit(s: str, n: int) -> str:
    return s if len(s) <= n else s[:max(1, n - 1)] + "…"


def agent_mark(agent: str, bold: bool = False) -> Text:
    a = AGENTS[agent]
    return Text.assemble((a["glyph"] + " ", f"bold {a['color']}"),
                         (a["short"], f"bold {INK}" if bold else MUTED))


def row_prompt(i: dict, terms: list[str], width: int = 56) -> Text:
    t = Text(no_wrap=True, overflow="ellipsis")
    if i["starred"]:
        t.append("★ ", style=f"bold {HILITE}")
    title = Text(fit(i["title"], width - (2 if i["starred"] else 0)), style=f"bold {INK}")
    title.highlight_words(terms, style=f"reverse {HILITE}", case_sensitive=False)
    t.append_text(title)
    t.append("\n")
    t.append("● ", style=color_for(i["project"]))
    t.append(i["project"], style=INK_2)
    if i["place"]:
        t.append("  " + fit(i["place"], width - len(i["project"]) - 4), style=MUTED)
    t.append("\n  ")
    t.append_text(agent_mark(i["agent"]))
    when = f"  ·  {i['dt']:%H:%M}" if i["dt"] else ""
    count = S["message"] if i["n_user"] == 1 else S["messages"].format(n=i["n_user"])
    t.append(f"{when}  ·  {count}", style=MUTED)
    if not i["exists"]:
        used = 4 + len(AGENTS[i["agent"]]["short"]) + len(when) + 5 + len(count)
        gone = f"  ·  ⚠ {S['folder_gone']}"
        t.append(gone if used + len(gone) <= width else "  ⚠", style=CRITICAL)
    snip = snippet(i, terms, width)
    if snip:
        t.append("\n")
        t.append_text(snip)
    t.append("\n")
    return t


def snippet(i: dict, terms: list[str], width: int) -> Text | None:
    if not terms or all(term in i["title"].lower() for term in terms):
        return None
    body = " ".join(" ".join(i["prompts"]).split())
    low = body.lower()
    pos = next((low.find(t) for t in terms if low.find(t) >= 0), -1)
    if pos < 0:
        return None
    start = max(0, pos - 20)
    frag = fit(("…" if start else "") + body[start:], width - 2)
    s = Text("  " + frag, style=f"italic {MUTED}", no_wrap=True, overflow="ellipsis")
    s.highlight_words(terms, style=f"bold {HILITE}", case_sensitive=False)
    return s


def side_row(dot: Text, name: str, n: int, bold=False, width: int = 22) -> Text:
    t = Text(no_wrap=True, overflow="ellipsis")
    if n == 0:  # no matches: keep the row (the list must not jump) but recede
        dot = Text(dot.plain, style=OTHER)
    t.append_text(dot)
    label = fit(name, width - len(str(n)) - 1)
    t.append(label, style=MUTED if n == 0 else f"{'bold ' if bold else ''}{INK}")
    t.append(" " * max(1, width - len(label) - len(str(n))))
    t.append(str(n), style=MUTED)
    return t


